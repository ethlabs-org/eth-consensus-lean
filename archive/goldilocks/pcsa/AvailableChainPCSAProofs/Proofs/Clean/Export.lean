variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
omit [Fintype V] in
/-- The predecessor invariant makes the actual proposer root compatible with its results. -/
theorem pcsa_clean_proposer_root_compatible (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (hF : StageOneFrame p c E rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    Block.Compatible
      (liveRoot p (clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1)))
        (proposerPC p (clock p (V2.D.Run.stateBefore E rho k x).st
          (SA.proposalTime p.toParams (s + 1))))) X := by
  let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  have hz : (controls p st).Z = .genesis := by
    change (KitFG.storeControlsView (FGSA.heightView p) (clock p _ _).fg).Z = .genesis
    rw [pcsa_body_clock_fg]
    exact (hF x hx k).2.1
  have htime : SA.proposalTime p.toParams (s + 1) - 1 < SA.voteTime p.toParams (s + 1) := by
    have hp : (0 : Int) < p.Δ := p.deltaPos
    change 4 * p.Δ * ((s + 1 : Nat) : Int) - 1 < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    linarith
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ p.deltaPos
  rcases pcsa_liveRoot_origin p st (proposerPC p st) with he | hm
  · rw [he]
    cases hv : proposerPC p st with
    | none =>
      change Block.Compatible (eraseFG (controls p st).Z) X
      rw [hz]
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
    | some C =>
      change Block.Compatible (if frameActive p st C then C.target else eraseFG (controls p st).Z) X
      split
      · have hC := (List.mem_filter.mp (bestPC_mem _ C hv)).1
        change C ∈ (clock p _ _).pcs at hC
        rw [pcsa_clock_pcs, pcsa_pre_tick_storeAt E rho h k x _ hk] at hC
        exact hCI.pcResults x hx y hy _ C s X htime hC (le_refl _) hX
      · rw [hz]
        exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
  · obtain ⟨row, hrow, hr, _, _⟩ := (pcsa_walkLocks_mem p st _ _).mp hm
    have hpre := pcsa_proposal_locks_subset p (V2.D.Run.stateBefore E rho k x).st (s + 1) hrow
    have hread := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime h.valid.toScheduleWellFormed
      h.noRestart hk
    rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ h.valid.toScheduleWellFormed] at hread
    rw [hread] at hpre
    obtain ⟨a, ha, i, Y, hevent, hY, hrowY, _⟩ := pcsa_lock_stateBefore_origin E rho h _ x row hpre
    have hgate := (Gen.V2.Duty.index_lt_idxBefore_iff h.valid.toScheduleWellFormed hevent _).mp ha
    have hi := pcsa_gate_label_lt_next_vote p i s (hgate.trans hpropVote)
    have hYX := (hCI.resultsChain x hx y hy i s Y X hi.le (le_refl _) hY hX).1 hi
    exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans (hr ▸ hrowY) hYX))
/-- The actual proposer walk extends every predecessor-label result. -/
theorem pcsa_clean_proposer_head_above_result (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (s : Slot) (hCI : CleanInvariantAt p c E rho s) (hc : SA.gateTime p.toParams s ≤ cut)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
    Block.Preceq X (getHead p st (proposerPC p st) (proposerVotes st (s + 1))
      (proposerSupport st (s + 1))) := by
  obtain ⟨a, ha, hresult⟩ := pcsa_gateResultAt_source E rho y s X hX
  have hroot := pcsa_clean_proposer_root_compatible E rho h.base hF s hCI k x y hx hy hk X hX
  have hfcut : SA.freezeTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 3 * p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    have hp : (0 : Int) < p.Δ := p.deltaPos
    linarith
  have hidx : V2.D.Run.idxBefore rho (SA.freezeTime p.toParams s) ≤ k := by
    apply Nat.le_of_not_gt
    intro hn
    have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mp hn
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * (s : Int) + 3 * p.Δ at ht
    push_cast at ht
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  have hpaths := pcsa_result_prefixes_retained E rho h.base hF h.healthy a k y x hy hx
    (SA.gateTime p.toParams s) (SA.proposalTime p.toParams (s + 1)) s X hfcut hidx hresult
  exact pcsa_gate_proposer_walk_counts E rho h.base hF h.healthy a k y x hy hx s X _ _ hc ha hk
    hresult hroot (fun B _ hBX => (hpaths B hBX).1)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] {c : AppCodec In} {m : FGMode}
/-- Predecessor CI bounds every pre-vote lock by each result of that predecessor label. -/
theorem pcsa_clean_pre_vote_lock_below_result (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : k ≤ V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1)))
    (row : Block × Nat × Time) (hr : row ∈ (V2.D.Run.stateBefore E rho k x).st.base.obligations)
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) : Block.Preceq row.1 X := by
  obtain ⟨a, ha, i, Y, he, hY, hp, _⟩ := pcsa_lock_stateBefore_origin E rho h k x row hr
  have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.valid.toScheduleWellFormed he _).mp
    (ha.trans_le hk)
  have hi := pcsa_gate_label_lt_next_vote p i s ht
  exact Gen.Pure.block_preceq_trans hp
    ((hCI.resultsChain x hx y hy i s Y X hi.le (le_refl _) hY hX).1 hi)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- An honest next-slot proposal fixes every honest HEAD from the predecessor CI. -/
theorem pcsa_clean_emitted_heads_equal (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hc : SA.gateTime p.toParams s ≤ cut) (N : NamedProposal p.n)
    (hx : rho.seatOf (.prop (s + 1)) (0 : Fin 1) ∈ rho.honest)
    (he : V2.D.Run.emits E rho (rho.seatOf (.prop (s + 1)) (0 : Fin 1))
      (⟨.seat (.prop (s + 1)) (0 : Fin 1), .proposal N⟩ : Obj p)
        (SA.proposalTime p.toParams (s + 1)))
    (y : V) (H : Block) (hH : HonestHeadAt p c E rho y (s + 1) H) : H = N.erase := by
  let x := rho.seatOf (.prop (s + 1)) (0 : Fin 1)
  obtain ⟨k, hk, _, hslot, hraw, hsup, hpc, hparent⟩ := pcsa_emitted_proposal_inputs E rho x
    (s + 1) N he
  let a := V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1))
  let src := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  let dst := clock p (V2.D.Run.stateBefore E rho a y).st (SA.voteTime p.toParams (s + 1))
  let Ts := erasedList src (fullTree p src)
  let Tt := erasedList dst (KitFG.storeFrameView (FGSA.heightView p) dst.fg (voterBlocks p dst (s
    + 1)))
  let rs := proposerVotes src (s + 1)
  let ss := proposerSupport src (s + 1)
  let rt := headVotes p dst (s + 1)
  let st := headSupport p dst (s + 1)
  let Rsrc := liveRoot p src (proposerPC p src)
  let Rdst := liveRoot p dst (voterPC p dst (s + 1))
  have hy := hH.1
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ hp
  have hvcut : SA.voteTime p.toParams (s + 1) ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    push_cast
    nlinarith
  have hkbefore : k ≤ a := Nat.le_of_lt
    ((Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mpr hpropVote)
  obtain ⟨hNwire, hNbody⟩ := pcsa_honest_proposal_before_vote E rho h.base hF h.healthy x y hx hy
    (s + 1) N he hvcut a (le_refl _)
  have hNdst : N.erase ∈ dst.base.blocks := by
    change N.erase ∈ (clock p _ _).base.blocks
    rwa [pcsa_clock_blocks]
  have hNslot : N.erase.slot = s + 1 := pcsa_proposal_emitted_slot E rho x (s + 1) N _ he
  have hNpositive : 0 < N.slot := by rw [hslot]; exact Nat.succ_pos _
  have hNparent := pcsa_named_parent_of_positive N hNpositive
  have hcount := pcsa_common_walk_counts E rho h.base hF h.healthy a k y hy s
    (SA.voteTime p.toParams (s + 1)) N hx he hk (le_refl _) hslot hNwire hc hraw hsup
  have hviews := pcsa_common_view_targets E rho h.base hF hFault h.healthy k y hy s N hx he hk
    hslot hvcut hNwire hpc
  have frame (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      FrameVacuous p (clock p (V2.D.Run.stateBefore E rho i z).st t) := by
    change (clock p _ t).fg.F = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).Z = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).lo = 0
    rw [pcsa_body_clock_fg]
    exact hF z hz i
  have hsrcF := frame k x hx (SA.proposalTime p.toParams (s + 1))
  have hdstF := frame a y hy (SA.voteTime p.toParams (s + 1))
  have hslots : src.slot p = dst.slot p :=
    (pcsa_proposal_clock_slot p _ (s + 1)).trans (pcsa_vote_clock_slot p _ (s + 1)).symm
  have heleg := pcsa_eligible_equal_counts p src dst rs ss rt st hsrcF.2.2 hdstF.2.2 hslots
    hcount.1 hcount.2.2
  have hhead : headVote p dst (s + 1) = H := by
    have hh := hH.2.2
    rw [pcsa_voteHeadAt_def] at hh
    obtain ⟨nd, hnd, hh⟩ := Option.map_eq_some_iff.mp hh
    obtain ⟨b, hb, hbSt⟩ := pcsa_postClock_source E rho y _ nd hnd
    have hpre := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime h.base.valid.toScheduleWellFormed
      h.base.noRestart hb
    rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ h.base.valid.toScheduleWellFormed] at hpre
    rw [hbSt, hpre] at hh
    exact hh
  have hghost : GridCO.ghost Rdst Tt (GridCO.goldfishScore dst.base.blocks rt st)
      (eligible p dst rt st) = H := by
    delta headVote at hhead
    rw [ite_eq_right (Nat.succ_ne_zero s)] at hhead
    exact hhead
  obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho h hF x hx s hc
  have hDparent : Block.Preceq D N.parent.erase := by
    rw [hparent]
    exact pcsa_clean_proposer_head_above_result E rho h hF s hCI hc k x x hx hx hk D hD
  have hDH : Block.Preceq D H := pcsa_clean_next_head_above E rho h hF s hCI hc x y hx D H hD hH
  have hsrcRootParent : Block.Preceq Rsrc N.parent.erase := by
    rw [hparent]
    exact pcsa_headInTree_extends_root p src _ _ rs ss
  have hsrcLocks : ∀ row ∈ src.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_clean_pre_vote_lock_below_result E rho h.base s hCI k x x hx hx hkbefore row
      (pcsa_proposal_locks_subset p _ (s + 1) hr) D hD
  have hdstLocks : ∀ row ∈ dst.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_clean_pre_vote_lock_below_result E rho h.base s hCI a y x hy hx (le_refl _) row
      (pcsa_vote_locks_subset p _ (s + 1) hr) D hD
  have hgeometry := pcsa_proposal_root_geometry p src dst (s + 1) N.parent.erase D H
    (pcsa_selected_walk_bases_eq p src dst (s + 1) hsrcF.2.1 hdstF.2.1 hviews)
    hsrcRootParent hDparent hDH hsrcLocks hdstLocks
  have unique (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      ∀ A ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
      ∀ B ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
        A.root = B.root → A = B := by
    intro A hA B hB hr
    have scope := pcsa_clock_body_scope p (RootBlockInRun p c E rho) _ t
      (pcsa_body_scope E rho i z hz)
    exact pcsa_scoped_root_eq E rho h.base.idealization A B (scope A hA) (scope B hB) hr
  have hsrcUnique : ∀ A ∈ Ts, ∀ B ∈ Ts, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique k x hx _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hdstUnique : ∀ A ∈ Tt, ∀ B ∈ Tt, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique a y hy _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hclosed : Gen.Pure.AnchorClosed Rsrc Ts := by
    intro B hB _ A _ hAB
    exact pcsa_full_read_prefix_mem E rho hF k x hx _ B A (List.mem_filter.mp hB).1 hAB
  have hretained (C : Block) (hC : Block.Preceq C N.erase) : C ∈ Tt :=
    pcsa_proposal_prefix_voter_mem E rho hF a y hy _ (s + 1) N.erase C hNdst hNslot hC
  have htree : ∀ C ∈ Tt, C = N.erase ∨ C ∈ Ts := by
    intro C hC
    rcases pcsa_voter_tree_source E rho h.base hF h.healthy a k y hy s
        (SA.voteTime p.toParams (s + 1)) N hx he hk (hpropVote.le.trans hvcut) C hC with
      hs | hpref
    · exact Or.inr hs
    · by_cases hn : C = N.erase
      · exact Or.inl hn
      · exact Or.inr (pcsa_proposal_proper_prefix_source E rho h.base hF k x hx (s + 1) N
          hparent C hpref hn)
  have hstop : Gen.Pure.NoEligibleChild Tt (eligible p dst rt st) N.erase := by
    intro B hB hpar
    have hb : B ∈ (V2.D.Run.stateBefore E rho a y).st.base.blocks := by
      have hb := (List.mem_filter.mp hB).1
      change B ∈ (clock p _ _).base.blocks at hb
      rwa [pcsa_clock_blocks] at hb
    have hg : B ≠ .genesis := by intro heq; rw [heq] at hpar; cases hpar
    have hparentB : B.parent = N.erase := by
      cases B with
      | genesis => cases hpar
      | node Q r root app => exact Option.some.inj hpar
    have hlt := pcsa_body_parent_slot_lt E rho h.base a y B hg hb
    rw [hparentB, hNslot] at hlt
    have htime : SA.voteTime p.toParams (s + 1) ≤ SA.proposalTime p.toParams (s + 1 + 1) := by
      change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤
        4 * p.Δ * ((s + 1 + 1 : Nat) : Int)
      push_cast
      nlinarith
    have hidx : a ≤ V2.D.Run.idxBefore rho (SA.proposalTime p.toParams (s + 1 + 1)) := by
      change V2.D.Run.idxBefore rho _ ≤ V2.D.Run.idxBefore rho _
      rw [V2.D.Run.idxBefore_def, V2.D.Run.idxBefore_def, ← List.countP_eq_length_filter,
        ← List.countP_eq_length_filter]
      exact List.countP_mono_left (fun e _ he =>
        decide_eq_true (lt_of_lt_of_le (of_decide_eq_true he) htime))
    exact (Nat.not_lt_of_ge (pcsa_body_slot_before_next_proposal E rho h.base a y (s + 1)
      hidx B hb) hlt).elim
  have hwalk := pcsa_retained_proposal_walk Rsrc Rdst N.parent.erase N.erase Ts Tt
    (GridCO.goldfishScore src.base.blocks rs ss) (GridCO.goldfishScore dst.base.blocks rt st)
    (eligible p src rs ss) (eligible p dst rt st) hsrcUnique hclosed hdstUnique hparent.symm
    hsrcRootParent hgeometry.1 (by simpa only [hghost] using hgeometry.2) hNparent
    (hretained N.erase (Gen.Pure.block_preceq_refl _))
    (pcsa_eligible_current_slot p dst rt st N.erase
      (hNslot.trans (pcsa_vote_clock_slot p _ (s + 1)).symm))
    (fun C hC => hretained C (Gen.Pure.block_preceq_trans hC (pcsa_named_parent_prefix N)))
    htree hcount.2.2 heleg hstop
  exact hghost.symm.trans hwalk
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The successor equal-HEAD field follows from the predecessor invariant and actual walks. -/
theorem pcsa_clean_headsEqual_step (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hc : SA.gateTime p.toParams (s + 1) ≤ cut) :
    ∀ i P x H, i ≤ s + 1 →
      Gen.V2.Duty.HonestProposalAt E (pcsaInterface p c (m := m)).toInterface rho i P →
      HonestHeadAt p c E rho x i H → H = P := by
  have hprev : SA.gateTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 6 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 6 * p.Δ
    push_cast
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  intro i P x H hi hP hH
  by_cases hold : i ≤ s
  · exact hCI.headsEqual i P x H hold hP hH
  · have his : i = s + 1 := Nat.le_antisymm hi (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
    subst i
    obtain ⟨hx, N, hN, he⟩ := pcsa_honest_proposal_named E rho (s + 1) P hP
    exact (pcsa_clean_emitted_heads_equal E rho h hF hFault s hCI hprev N hx he x H hH).trans hN
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The C6 successor record and earlier-ack coverage are constructed together. -/
theorem pcsa_clean_joint_step (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hAux : CleanAckCoverageAt p c E rho s) (hc : SA.gateTime p.toParams (s + 1) ≤ cut) :
    CleanInvariantAt p c E rho (s + 1) ∧ CleanAckCoverageAt p c E rho (s + 1) := by
  have hheads := pcsa_clean_headsAbove_step E rho h hF s hCI hc
  have hchain := pcsa_clean_resultsChain_step E rho h hF s hCI hc
  have hequal := pcsa_clean_headsEqual_step E rho h hF hFault s hCI hc
  have hpast := pcsa_heads_cover_past_results E rho h hF (s + 1) hc hchain hheads
  have hDresults : ∀ i k, i < k → k ≤ s + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x ∈ rho.honest, ∀ X, gateResultAt p c E rho x k = some (some X) → Block.Preceq B X := by
    intro i k hik hk y B hB x hx X hX
    by_cases hold : k ≤ s
    · exact hAux.results i k hik hold y B hB x hx X hX
    · have he : k = s + 1 := Nat.le_antisymm hk (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      exact pcsa_clean_result_covers_heads E rho h hF x hx (s + 1) B X hc
        (fun z H hH => hAux.heads i (s + 1) hik (le_refl _) y B hB z H hH) hX
  have hAckResults := pcsa_ack_result_compatible E rho h hF hFault (s + 1) hc hpast hDresults
  have hroots : ∀ x ∈ rho.honest, ∀ R,
      liveRootAt p c E rho x (s + 1 + 1) = some R →
      ∀ y ∈ rho.honest, ∀ X, gateResultAt p c E rho y (s + 1) = some (some X) →
        Block.Compatible R X := by
    intro x hx R hR y hy X hX
    rcases pcsa_next_root_source E rho h.base hF hFault x hx (s + 1) R hR with
      hgen | ⟨z, i, hAck, ht⟩ | ⟨i, Y, hi, hY, hRY⟩
    · rw [hgen]
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
    · exact hAckResults i (pcsa_early_label_before_vote p i (s + 1) ht) z R hAck
        (s + 1) (le_refl _) y hy X hX
    · exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hRY
        ((hchain x hx y hy i (s + 1) Y X hi.le (le_refl _) hY hX).1 hi)))
  have hDheads : ∀ i k, i < k → k ≤ s + 1 + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x H, HonestHeadAt p c E rho x k H → Block.Preceq B H := by
    intro i k hik hk y B hB x H hH
    by_cases hold : k ≤ s + 1
    · exact hAux.heads i k hik hold y B hB x H hH
    · have he : k = s + 1 + 1 := Nat.le_antisymm hk
        (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      have hi : i ≤ s + 1 := Nat.le_of_lt_succ hik
      rcases hi.lt_or_eq with hi | hi
      · obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho h hF y hB.1 (s + 1) hc
        have hBD := hDresults i (s + 1) hi (le_refl _) y B hB y hB.1 D hD
        have hDH := pcsa_next_head_above_result_of_root E rho h.base hF h.healthy y x hB.1
          (s + 1) D H hc hD hH (fun R hR => hroots x hH.1 R hR y hB.1 D hD)
        exact Gen.Pure.block_preceq_trans hBD hDH
      · subst i
        exact pcsa_ack_dissemination_step E rho h hF hFault (s + 1) hc
          (hpast (s + 1) (le_refl _))
          (fun i hi y B hB x H hH => hAux.heads i (s + 1) hi (le_refl _) y B hB x H hH)
          y x B H hB hH
  have hresultCompatible : ∀ x ∈ rho.honest, ∀ y ∈ rho.honest, ∀ i i' X Y,
      i ≤ s + 1 → i' ≤ s + 1 → gateResultAt p c E rho x i = some (some X) →
      gateResultAt p c E rho y i' = some (some Y) → Block.Compatible X Y := by
    intro x hx y hy i i' X Y hi hi' hX hY
    rcases le_total i i' with hle | hle
    · rcases hle.lt_or_eq with hlt | he
      · exact Bool.or_eq_true_iff.mpr (Or.inl ((hchain x hx y hy i i' X Y hle hi' hX hY).1 hlt))
      · exact (hchain x hx y hy i i' X Y hle hi' hX hY).2 he
    · rcases hle.lt_or_eq with hlt | he
      · exact Bool.or_eq_true_iff.mpr (Or.inr ((hchain y hy x hx i' i Y X hle hi hY hX).1 hlt))
      · exact (hchain x hx y hy i i' X Y (Nat.le_of_eq he.symm) hi' hX hY).2 he.symm
  refine ⟨{
    resultsChain := hchain
    headsAbove := hheads
    headsEqual := hequal
    pcAck := ?_
    pcChain := ?_
    pcResults := ?_
    leaseBelowResult := ?_
    leaseCompatible := ?_
    lockWriteAll := ?_
    lockKeep := ?_
    recordOrigin := ?_
    recordMono := ?_
    recordCompatible := ?_
    roots := hroots }, ⟨hDheads, hDresults⟩⟩
  · intro x hx t C ht hC
    exact (pcsa_pc_storeAt_ack_slot E rho h.base hFault (s + 1) x hx t ht C hC).2
  · intro x hx y hy t t' C D ht ht' hC hD
    exact pcsa_pc_storeAt_chain E rho h.base hF hFault (s + 1)
      (fun i i' hi hi' y A hA z H hH => hAux.heads i i' hi hi' y A hA z H hH)
      x y hx hy t t' ht ht' C D hC hD
  · intro x hx y hy t C i X ht hC hi hX
    exact pcsa_pc_storeAt_result E rho h hF hFault (s + 1) hc hpast hDresults
      x y hx hy t ht C hC i hi X hX
  · intro x hx t row ht hr
    obtain ⟨i, X, hi, hX, hb, _⟩ := pcsa_lock_storeAt_origin E rho h.base x t (s + 1) ht row hr
    exact ⟨x, hx, i, X, hi, hX, hb⟩
  · intro x hx t B C ht hLive hC
    obtain ⟨row, hr, he, _⟩ := hLive
    obtain ⟨i, X, hi, hX, hb, _⟩ := pcsa_lock_storeAt_origin E rho h.base x t (s + 1) ht row hr
    obtain ⟨hj, y, ha⟩ := pcsa_pc_storeAt_ack_slot E rho h.base hFault (s + 1) x hx t ht C hC
    have hc := hAckResults C.slot hj y C.target ha i hi x hx X hX
    have hBX : Block.Preceq B X := he ▸ hb
    rcases Bool.or_eq_true_iff.mp hc with hCX | hXC
    · exact Gen.Pure.block_compatible_of_common hBX hCX
    · exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hBX hXC))
  · intro x hx i st X b hi hst hX hb
    exact pcsa_lock_write_all_of_ack_results E rho h.base hFault (s + 1) hAckResults
      x hx i hi st X b hst hX hb
  · intro x hx k e he ht row hr hlive
    exact pcsa_lock_keep_of_chain E rho h.base hF hFault (s + 1) hpast hAckResults
      x hx k e he ht row hr hlive
  · intro x hx t ht
    rcases pcsa_record_storeAt_origin E rho h.base hF x hx t (s + 1) ht with hz | hresult
    · left
      have hf : (storeAt p c E rho x t).fg.F = .genesis := by
        rw [storeAt_def, V2.D.Engine.readAt_eq_stateBefore h.base.valid.toScheduleWellFormed]
        exact (hF x hx _).1
      rw [hz, hf]
      rfl
    · exact Or.inr hresult
  · intro x hx t t' htt ht'
    exact pcsa_record_storeAt_mono E rho h.base hF (s + 1) x hx
      (fun i i' X Y hi hi' hX hY => (hchain x hx x hx i i' X Y hi.le hi' hX hY).1 hi)
      t t' htt ht'
  · intro x hx y hy t t' ht ht'
    exact pcsa_record_storeAt_compatible E rho h.base hF (s + 1) hresultCompatible
      x y hx hy t t' ht ht'
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The stage-one Clean invariant and ack coverage hold by joint induction over gate labels. -/
theorem pcsa_clean_joint_invariant (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) :
    ∀ j, SA.gateTime p.toParams j ≤ cut →
      CleanInvariantAt p c E rho j ∧ CleanAckCoverageAt p c E rho j := by
  intro j
  induction j with
  | zero =>
    intro hc
    exact ⟨pcsa_clean_invariant_zero E rho h hFault hF hc,
      pcsa_ack_coverage_zero E rho h.base hF hFault⟩
  | succ j ih =>
    intro hc
    obtain ⟨hCI, hAux⟩ := ih ((pcsa_gate_time_mono p (Nat.le_succ j)).trans hc)
    exact pcsa_clean_joint_step E rho h hF hFault j hCI hAux hc
/-- C6: the full stage-one Clean invariant holds at every gate inside the healthy prefix. -/
theorem pcsa_clean_invariant (p : Params) : CleanInvariantClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF j hc
  exact (pcsa_clean_joint_invariant E rho h hF hFault j hc).1
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- C6 at completed gates makes S monotone throughout the healthy prefix. -/
theorem pcsa_clean_record_mono_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t t' : Time)
    (htt : t ≤ t') (hc : t' ≤ cut) :
    Block.Preceq (storeAt p c E rho x t).base.stableRecord
      (storeAt p c E rho x t').base.stableRecord := by
  rw [storeAt_def, storeAt_def, V2.D.Engine.readAt_eq_stateBefore h.base.valid.toScheduleWellFormed,
    V2.D.Engine.readAt_eq_stateBefore h.base.valid.toScheduleWellFormed]
  apply pcsa_record_indices_mono_at_limit E rho h.base hF
    (rho.events.filter (fun e : V2.Event V (Obj p) => decide (e.time ≤ cut))).length x hx
    ?_ _ _ (V2.D.Engine.read_length_mono t t' htt) (V2.D.Engine.read_length_mono t' cut hc)
  intro i i' X Y hi k hk hkl hX hY
  have hgate := (V2.D.Engine.index_lt_read_length_iff h.base.valid.toScheduleWellFormed cut hk).mp
    hkl
  have hCI := (pcsa_clean_joint_invariant E rho h hF hFault i' hgate).1
  exact (hCI.resultsChain x hx x hx i i' X Y hi.le (le_refl _) hX hY).1 hi
/-- A HEAD whose early time is inside the prefix covers every earlier honest result. -/
theorem pcsa_clean_head_above_past_at_early (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hc : SA.earlyTime p.toParams s ≤ cut)
    (x : V) (H : Block) (hH : HonestHeadAt p c E rho x s H)
    (y : V) (hy : y ∈ rho.honest) (i : Slot) (X : Block) (hi : i < s)
    (hX : gateResultAt p c E rho y i = some (some X)) : Block.Preceq X H := by
  cases s with
  | zero => exact (Nat.not_lt_zero i hi).elim
  | succ s =>
    rw [earlyTime_succ_eq_gateTime] at hc
    have hCI := (pcsa_clean_joint_invariant E rho h hF hFault s hc).1
    obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho h hF y hy s hc
    have his : i ≤ s := Nat.le_of_lt_succ hi
    have hXD : Block.Preceq X D := by
      rcases his.lt_or_eq with hlt | heq
      · exact (hCI.resultsChain y hy y hy i s X D his (le_refl _) hX hD).1 hlt
      · subst i
        have he : X = D := Option.some.inj (Option.some.inj (hX.symm.trans hD))
        rw [he]
        exact Gen.Pure.block_preceq_refl _
    exact Gen.Pure.block_preceq_trans hXD
      (pcsa_clean_next_head_above E rho h hF s hCI hc y x hy D H hD hH)
/-- Earlier honest ack targets are below every later ack target observed within the prefix. -/
theorem pcsa_clean_ack_targets_order_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (i s : Slot) (hi : i < s)
    (hc : SA.earlyTime p.toParams s ≤ cut) (x y : V) (B C : Block)
    (hB : HonestAckAt p c E rho x i B) (hC : HonestAckAt p c E rho y s C) :
    Block.Preceq B C := by
  cases s with
  | zero => exact (Nat.not_lt_zero i hi).elim
  | succ s =>
    rw [earlyTime_succ_eq_gateTime] at hc
    have hAux := (pcsa_clean_joint_invariant E rho h hF hFault s hc).2
    obtain ⟨z, hz⟩ := pcsa_ack_has_honest_head E rho h.base hF hFault y (s + 1) C hC
    exact hAux.heads i (s + 1) hi (le_refl _) x B hB z C hz
/-- An observed honest ack target is compatible with each completed result in the prefix. -/
theorem pcsa_clean_ack_result_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hs : SA.earlyTime p.toParams s ≤ cut)
    (z : V) (B : Block) (ha : HonestAckAt p c E rho z s B)
    (i : Slot) (hi : SA.gateTime p.toParams i ≤ cut) (y : V) (hy : y ∈ rho.honest) (X : Block)
    (hX : gateResultAt p c E rho y i = some (some X)) : Block.Compatible B X := by
  rcases lt_trichotomy s i with hlt | heq | hgt
  · have hAux := (pcsa_clean_joint_invariant E rho h hF hFault i hi).2
    exact Bool.or_eq_true_iff.mpr (Or.inl (hAux.results s i hlt (le_refl _) z B ha y hy X hX))
  · subst i
    exact pcsa_honestAck_same_label_result E rho h hF hFault z y hy s B X hi ha hX
  · obtain ⟨u, hu⟩ := pcsa_ack_has_honest_head E rho h.base hF hFault z s B ha
    exact Bool.or_eq_true_iff.mpr (Or.inr
      (pcsa_clean_head_above_past_at_early E rho h hF hFault s hs u B hu y hy i X hgt hX))
/-- The selected PC target moves forward between inclusive reads in the healthy prefix. -/
theorem pcsa_clean_pcTarget_mono_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t t' : Time)
    (htt : t ≤ t') (hc : t' ≤ cut) (B : Block) (hB : pcTarget? (storeAt p c E rho x t) = some B) :
    ∃ C, pcTarget? (storeAt p c E rho x t') = some C ∧ Block.Preceq B C := by
  obtain ⟨P, hP, _, hPB⟩ := pcsa_pcTarget_source _ B hB
  have hPnew := pcsa_storeAt_pcs_mono E rho h.base hF x hx t t' htt hP
  obtain ⟨Q, hQ⟩ := Option.isSome_iff_exists.mp (pcsa_bestPC_isSome_of_mem _ P hPnew)
  have hQmem := bestPC_mem _ Q hQ
  refine ⟨Q.target, ?_, ?_⟩
  · change (bestPC _).map PC.target = some Q.target
    rw [hQ]
    rfl
  · rw [← hPB]
    obtain ⟨_, y, hy, _⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault x hx t P hP
    obtain ⟨_, z, hz, htime⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault x hx t' Q hQmem
    have hslot := pcsa_clean_bestPC_slot_ge _ P Q hPnew hQ
    rcases hslot.lt_or_eq with hlt | heq
    · exact pcsa_clean_ack_targets_order_cut E rho h hF hFault P.slot Q.slot hlt
        (htime.trans hc) y z P.target Q.target hy hz
    · rw [pcsa_ack_targets_unique E rho h.base hF hFault y z Q.slot P.target Q.target
        (heq ▸ hy) hz]
      exact Gen.Pure.block_preceq_refl _
/-- A selected PC is compatible with S at every inclusive read inside the prefix. -/
theorem pcsa_clean_pc_record_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t : Time) (hc : t ≤ cut)
    (B : Block) (hB : pcTarget? (storeAt p c E rho x t) = some B) :
    Block.Compatible B (storeAt p c E rho x t).base.stableRecord := by
  obtain ⟨C, hC, _, hCB⟩ := pcsa_pcTarget_source _ B hB
  obtain ⟨_, y, hy, htime⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault x hx t C hC
  rcases pcsa_record_storeAt_timed_origin E rho h.base hF x hx t with hz | ⟨i, X, hi, hX, hs⟩
  · rw [hz]
    exact Bool.or_eq_true_iff.mpr (Or.inr (Gen.Pure.block_genesis_preceq B))
  · rw [hs, ← hCB]
    exact pcsa_clean_ack_result_cut E rho h hF hFault C.slot (htime.trans hc) y C.target hy
      i (hi.trans hc) x hx X hX
/-- The concrete available output is monotone at all inclusive reads through the cut. -/
theorem pcsa_clean_available_mono_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t t' : Time)
    (htt : t ≤ t') (hc : t' ≤ cut) :
    Block.Preceq (confirmed (storeAt p c E rho x t))
      (confirmed (storeAt p c E rho x t')) := by
  rw [confirmed_eq_pcFloor, confirmed_eq_pcFloor]
  exact Gen.Pure.pcFloor_mono
    (pcsa_clean_record_mono_cut E rho h hF hFault x hx t t' htt hc)
    (pcsa_clean_pcTarget_mono_cut E rho h hF hFault x hx t t' htt hc)
    (pcsa_clean_pc_record_cut E rho h hF hFault x hx t' hc)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- Honest records at any two reads inside the healthy prefix are compatible. -/
theorem pcsa_clean_records_compatible_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (t u : Time) (ht : t ≤ cut) (hu : u ≤ cut) :
    Block.Compatible (storeAt p c E rho x t).base.stableRecord
      (storeAt p c E rho y u).base.stableRecord := by
  rcases pcsa_record_storeAt_timed_origin E rho h.base hF x hx t with hg | ⟨i, X, hi, hX, hs⟩
  · rw [hg]
    exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq _))
  · rw [hs]
    rcases pcsa_record_storeAt_timed_origin E rho h.base hF y hy u with hg | ⟨j, Y, hj, hY, hs'⟩
    · rw [hg]
      exact Bool.or_eq_true_iff.mpr (Or.inr (Gen.Pure.block_genesis_preceq _))
    · rw [hs']
      rcases lt_trichotomy i j with hlt | heq | hgt
      · have hCI := (pcsa_clean_joint_invariant E rho h hF hFault j (hj.trans hu)).1
        exact Bool.or_eq_true_iff.mpr (Or.inl
          ((hCI.resultsChain x hx y hy i j X Y hlt.le (le_refl _) hX hY).1 hlt))
      · have hCI := (pcsa_clean_joint_invariant E rho h hF hFault j (hj.trans hu)).1
        exact (hCI.resultsChain x hx y hy i j X Y heq.le (le_refl _) hX hY).2 heq
      · have hCI := (pcsa_clean_joint_invariant E rho h hF hFault i (hi.trans ht)).1
        exact Bool.or_eq_true_iff.mpr (Or.inr
          ((hCI.resultsChain y hy x hx j i Y X hgt.le (le_refl _) hY hX).1 hgt))
/-- A selected PC target is compatible with every honest record read inside the prefix. -/
theorem pcsa_clean_pc_record_cross_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (t u : Time) (ht : t ≤ cut) (hu : u ≤ cut) (B : Block)
    (hB : pcTarget? (storeAt p c E rho x t) = some B) :
    Block.Compatible B (storeAt p c E rho y u).base.stableRecord := by
  obtain ⟨C, hC, _, hCB⟩ := pcsa_pcTarget_source _ B hB
  obtain ⟨_, z, hz, hc⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault x hx t C hC
  rcases pcsa_record_storeAt_timed_origin E rho h.base hF y hy u with hg | ⟨i, X, hi, hX, hs⟩
  · rw [hg]
    exact Bool.or_eq_true_iff.mpr (Or.inr (Gen.Pure.block_genesis_preceq _))
  · rw [hs, ← hCB]
    exact pcsa_clean_ack_result_cut E rho h hF hFault C.slot (hc.trans ht) z C.target hz
      i (hi.trans hu) y hy X hX
/-- Selected PC targets at any two honest prefix reads are compatible. -/
theorem pcsa_clean_pc_targets_compatible_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (t u : Time) (ht : t ≤ cut) (hu : u ≤ cut) (B C : Block)
    (hB : pcTarget? (storeAt p c E rho x t) = some B)
    (hC : pcTarget? (storeAt p c E rho y u) = some C) : Block.Compatible B C := by
  obtain ⟨P, hP, _, hPB⟩ := pcsa_pcTarget_source _ B hB
  obtain ⟨Q, hQ, _, hQC⟩ := pcsa_pcTarget_source _ C hC
  obtain ⟨_, z, hz, hPtime⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault x hx t P hP
  obtain ⟨_, w, hw, hQtime⟩ := pcsa_pc_storeAt_timed_ack E rho h.base hFault y hy u Q hQ
  rw [← hPB, ← hQC]
  rcases lt_trichotomy P.slot Q.slot with hlt | heq | hgt
  · exact Bool.or_eq_true_iff.mpr (Or.inl (pcsa_clean_ack_targets_order_cut E rho h hF hFault
      P.slot Q.slot hlt (hQtime.trans hu) z w P.target Q.target hz hw))
  · rw [pcsa_ack_targets_unique E rho h.base hF hFault z w Q.slot P.target Q.target
      (heq ▸ hz) hw]
    exact Gen.Pure.block_compatible_of_common (Gen.Pure.block_preceq_refl _)
      (Gen.Pure.block_preceq_refl _)
  · exact Bool.or_eq_true_iff.mpr (Or.inr (pcsa_clean_ack_targets_order_cut E rho h hF hFault
      Q.slot P.slot hgt (hPtime.trans ht) w z Q.target P.target hw hz))
/-- Available outputs at any two honest prefix reads are compatible. -/
theorem pcsa_clean_confirmed_compatible_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (t u : Time) (ht : t ≤ cut) (hu : u ≤ cut) :
    Block.Compatible (confirmed (storeAt p c E rho x t)) (confirmed (storeAt p c E rho y u)) := by
  rcases pcsa_confirmed_source (storeAt p c E rho x t) with hs | ⟨B, hB, hOut⟩
  · rw [hs]
    rcases pcsa_confirmed_source (storeAt p c E rho y u) with hs' | ⟨C, hC, hOut⟩
    · rw [hs']
      exact pcsa_clean_records_compatible_cut E rho h hF hFault x y hx hy t u ht hu
    · rw [hOut]
      change Block.compatible _ C = true
      rw [Gen.Pure.block_compatible_comm]
      exact pcsa_clean_pc_record_cross_cut E rho h hF hFault y x hy hx u t hu ht C hC
  · rw [hOut]
    rcases pcsa_confirmed_source (storeAt p c E rho y u) with hs | ⟨C, hC, hOut⟩
    · rw [hs]
      exact pcsa_clean_pc_record_cross_cut E rho h hF hFault x y hx hy t u ht hu B hB
    · rw [hOut]
      exact pcsa_clean_pc_targets_compatible_cut E rho h hF hFault x y hx hy t u ht hu B C hB hC
/-- Strong outputs at any two honest prefix reads are compatible. -/
theorem pcsa_clean_strong_compatible_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (t u : Time) (ht : t ≤ cut) (hu : u ≤ cut) :
    Block.Compatible (strong (storeAt p c E rho x t)) (strong (storeAt p c E rho y u)) := by
  change Block.Compatible ((pcTarget? _).getD .genesis) ((pcTarget? _).getD .genesis)
  cases hp : pcTarget? (storeAt p c E rho x t) with
  | none => exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq _))
  | some B =>
    cases hq : pcTarget? (storeAt p c E rho y u) with
    | none => exact Bool.or_eq_true_iff.mpr (Or.inr (Gen.Pure.block_genesis_preceq _))
    | some C =>
      exact pcsa_clean_pc_targets_compatible_cut E rho h hF hFault x y hx hy t u ht hu B C hp hq
/-- Strong outputs are monotone between honest reads in the prefix. -/
theorem pcsa_clean_strong_mono_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t u : Time)
    (htu : t ≤ u) (hu : u ≤ cut) :
    Block.Preceq (strong (storeAt p c E rho x t)) (strong (storeAt p c E rho x u)) := by
  change Block.Preceq ((pcTarget? _).getD .genesis) ((pcTarget? _).getD .genesis)
  cases hp : pcTarget? (storeAt p c E rho x t) with
  | none => exact Gen.Pure.block_genesis_preceq _
  | some B =>
    obtain ⟨C, hC, hBC⟩ := pcsa_clean_pcTarget_mono_cut E rho h hF hFault x hx t u htu hu B hp
    rw [hC]
    exact hBC
/-- Clean dissemination follows from the auxiliary coverage proved jointly with C6. -/
theorem pcsa_clean_dissemination (p : Params) : CleanDisseminationClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF s y B hc hAck
  have hAux := (pcsa_clean_joint_invariant E rho h hF hFault (s + 1) hc).2
  exact ⟨fun x H hH => hAux.heads s (s + 1) (Nat.lt_succ_self _) (Nat.le_succ _) y B hAck x H hH,
    fun x hx X hX => hAux.results s (s + 1) (Nat.lt_succ_self _) (le_refl _) y B hAck x hx X hX⟩
/-- Clean safety holds for available and strong outputs throughout the healthy prefix. -/
theorem pcsa_clean_safety (p : Params) : PCSACleanSafetyClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF x hx y hy t u _ ht _ hu
  refine ⟨pcsa_clean_confirmed_compatible_cut E rho h hF hFault x y hx hy t u ht hu,
    pcsa_clean_strong_compatible_cut E rho h hF hFault x y hx hy t u ht hu, ?_⟩
  intro htu
  exact ⟨pcsa_clean_available_mono_cut E rho h hF hFault x hx t u htu hu,
    pcsa_clean_strong_mono_cut E rho h hF hFault x hx t u htu hu⟩
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] {c : AppCodec In} {m : FGMode}
/-- The C6 result chain makes the lock guard clear at each exact honest gate input. -/
theorem pcsa_clean_gate_guard (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (s : Slot) (hCI : CleanInvariantAt p c E rho s) (k : Nat) (x : V) (hx : x ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.gateTime p.toParams s)))
    (X : Block) (hX : gateResultAt p c E rho x s = some (some X)) :
    (clockPre p (V2.D.Run.stateBefore E rho k x).st (SA.gateTime p.toParams s)).base.obligations.any
      (fun row => (clockPre p (V2.D.Run.stateBefore E rho k x).st
        (SA.gateTime p.toParams s)).base.now < row.2.2 && !Block.compatible row.1 X) = false :=
  pcsa_gate_guard_of_chain E rho h s k x hk X (fun i Y hi hY =>
    (hCI.resultsChain x hx x hx i s Y X hi.le (le_refl _) hY hX).1 hi)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- Completed-gate order preserves S between arbitrary indices inside the healthy prefix. -/
theorem pcsa_clean_record_indices_mono_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest)
    (a b : Nat) (hab : a ≤ b)
    (hb : b ≤ (rho.events.filter (fun e => decide (e.time ≤ cut))).length) :
    Block.Preceq (V2.D.Run.stateBefore E rho a x).st.base.stableRecord
      (V2.D.Run.stateBefore E rho b x).st.base.stableRecord := by
  apply pcsa_record_indices_mono_at_limit E rho h.base hF _ x hx ?_ a b hab hb
  intro i i' X Y hi k hk hkl hX hY
  have hgate := (V2.D.Engine.index_lt_read_length_iff h.base.valid.toScheduleWellFormed cut hk).mp
    hkl
  have hCI := (pcsa_clean_joint_invariant E rho h hF hFault i' hgate).1
  exact (hCI.resultsChain x hx x hx i i' X Y hi.le (le_refl _) hX hY).1 hi
/-- Clean inclusion: every honest proposal is below all available outputs from its gate onward. -/
theorem pcsa_clean_inclusion (p : Params) : PCSACleanInclusionClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF s P hP x hx t hgate ht
  have hc : SA.gateTime p.toParams s ≤ cut := hgate.trans ht
  have hCI := (pcsa_clean_joint_invariant E rho h hF hFault s hc).1
  obtain ⟨X, hX⟩ := pcsa_clean_result_exists E rho h hF x hx s hc
  have hPX : Block.Preceq P X := pcsa_clean_result_covers_heads E rho h hF x hx s P X hc
    (fun y H hH => by
      rw [hCI.headsEqual s P y H (le_refl _) hP hH]
      exact Gen.Pure.block_preceq_refl _) hX
  obtain ⟨k, hk, hraw⟩ := pcsa_gateResultAt_source E rho x s X hX
  rw [pcsa_clock_confirmation_eq_pre] at hraw
  have hXS := pcsa_clock_gate_record_covers_result p (V2.D.Run.stateBefore E rho k x).st s X
    (hF x hx k).1 (pcsa_gate_input_unsaved E rho h.base.valid.nodup k x s hk) hraw
    (pcsa_clean_gate_guard E rho h.base s hCI k x hx hk X hX)
  have hpost : (V2.D.Run.stateBefore E rho (k + 1) x).st =
      clock p (V2.D.Run.stateBefore E rho k x).st (SA.gateTime p.toParams s) := by
    rw [V2.D.Run.stateBefore_succ E rho hk]
    change (Function.update (V2.D.Run.stateBefore E rho k) x _ x).st = _
    rw [Function.update_self]
    exact pcsa_tick_st E rho (V2.D.Run.stateBefore E rho k x) x _
  rw [← hpost] at hXS
  have hkt : k + 1 ≤ (rho.events.filter (fun e : V2.Event V (Obj p) => decide (e.time ≤
    t))).length :=
    Nat.succ_le_of_lt ((V2.D.Engine.index_lt_read_length_iff h.base.valid.toScheduleWellFormed t
      hk).mpr hgate)
  have hmono := pcsa_clean_record_indices_mono_cut E rho h hF hFault x hx (k + 1) _ hkt
    (V2.D.Engine.read_length_mono (rho := rho) t cut ht)
  have hPSt : Block.Preceq P (storeAt p c E rho x t).base.stableRecord := by
    rw [storeAt_def, V2.D.Engine.readAt_eq_stateBefore h.base.valid.toScheduleWellFormed]
    exact Gen.Pure.block_preceq_trans hPX (Gen.Pure.block_preceq_trans hXS hmono)
  apply Gen.Pure.block_preceq_trans hPSt
  rw [confirmed_eq_pcFloor]
  exact Gen.Pure.self_preceq_pcFloor (pcsa_clean_pc_record_cut E rho h hF hFault x hx t ht)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
/-- M1: pending clean result reads are not empty. -/
theorem pcsa_clean_results_nonempty (p : Params) : CleanResultsNonemptyClaim p := by
  intro V _ _ In c m E rho cut ΔF h _ hF i hi x hx
  exact pcsa_pending_result_nonempty E rho h hF x hx i hi
/-- M2: a pending result extends every earlier honest result. -/
theorem pcsa_clean_results_chain_pending (p : Params) : CleanResultsChainPendingClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF i j x y X Y hij hj hx hy hX hY
  exact pcsa_pending_result_covers_heads E rho h hF y hy j X Y hj
    (fun z H hH => pcsa_clean_head_above_past_at_early E rho h hF hFault j hj z H hH
      x hx i X hij hX) hY
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- A completed clean gate places its raw result below the actual post-event S. -/
theorem pcsa_clean_result_below_post_gate (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (i : Slot) (hc : SA.gateTime p.toParams i ≤ cut)
    (x : V) (hx : x ∈ rho.honest) (k : Nat)
    (hk : rho.events[k]? = some (.tick x (SA.gateTime p.toParams i))) (X : Block)
    (hX : gateResultAt p c E rho x i = some (some X)) :
    Block.Preceq X (V2.D.Run.stateBefore E rho (k + 1) x).st.base.stableRecord :=
  pcsa_result_below_post_gate_of_chain E rho h.base hF i x hx k hk X hX (fun i' Y hi hY =>
    ((pcsa_clean_joint_invariant E rho h hF hFault i hc).1.resultsChain x hx x hx i' i Y X hi.le
      (le_refl _) hY hX).1 hi)
/-- Every lock at an inclusive read through the clean cut is below the S of that read. -/
theorem pcsa_clean_lock_below_record_cut (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (x : V) (hx : x ∈ rho.honest) (t : Time) (ht : t ≤ cut)
    (row : Block × Nat × Time) (hr : row ∈ (storeAt p c E rho x t).base.obligations) :
    Block.Preceq row.1 (storeAt p c E rho x t).base.stableRecord :=
  pcsa_lock_below_record_of_chain E rho h.base hF x hx (fun i i' X Y hi hc hX hY =>
    ((pcsa_clean_joint_invariant E rho h hF hFault i' hc).1.resultsChain x hx x hx i i' X Y hi.le
      (le_refl _) hX hY).1 hi) t ht row hr
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
/-- The clean block-receipt claim follows from exact acceptance and strict relay. -/
theorem pcsa_clean_block_receipt (p : Params) : CleanBlockReceiptClaim p := by
  intro V _ _ In c m E rho cut ΔF h _ hF x hx T B _ hc hB y hy t ht
  exact pcsa_body_storeAt_relay E rho h.base hF h.healthy x y hx hy T t B hc ht hB
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- Earlier ack targets are below later honest HEADs whose early time is in the prefix. -/
theorem pcsa_clean_ack_to_head_at_early (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (i s : Slot) (hi : i < s)
    (hc : SA.earlyTime p.toParams s ≤ cut) (x y : V) (B H : Block)
    (hB : HonestAckAt p c E rho x i B) (hH : HonestHeadAt p c E rho y s H) :
    Block.Preceq B H := by
  cases s with
  | zero => exact (Nat.not_lt_zero i hi).elim
  | succ s =>
    rw [earlyTime_succ_eq_gateTime] at hc
    have hAux := (pcsa_clean_joint_invariant E rho h hF hFault s hc).2
    exact hAux.heads i (s + 1) hi (le_refl _) x B hB y H hH
/-- The current honest ack reaches the next HEAD when that vote is inside the clean cut. -/
theorem pcsa_clean_ack_next_head_pending (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (y : V) (B : Block)
    (hB : HonestAckAt p c E rho y s B) (hc : SA.voteTime p.toParams (s + 1) ≤ cut)
    (x : V) (H : Block) (hH : HonestHeadAt p c E rho x (s + 1) H) : Block.Preceq B H := by
  have hearly : SA.earlyTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 2 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    push_cast
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  apply pcsa_honestAck_next_head_of_root_at_vote E rho h hF hFault y x s B H hc hB hH
  intro R hR
  exact Bool.or_eq_true_iff.mpr (Or.inl (pcsa_ack_next_root_below E rho h.base hF hFault s
    (pcsa_clean_head_above_past_at_early E rho h hF hFault s hearly)
    (fun i hi z A hA w K hK => pcsa_clean_ack_to_head_at_early E rho h hF hFault
      i s hi hearly z w A K hA hK) x y hH.1 B R hB hR))
/-- M3: honest acks disseminate to the pending next HEAD and result at the stated cutoffs. -/
theorem pcsa_clean_dissemination_pending (p : Params) : CleanDisseminationPendingClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF s y B hB
  constructor
  · intro hc x H hH
    exact pcsa_clean_ack_next_head_pending E rho h hF hFault s y B hB hc x H hH
  · intro hc x hx X hX
    have hgate : SA.gateTime p.toParams s ≤ cut := by
      rw [← earlyTime_succ_eq_gateTime]
      exact hc
    have hAux := (pcsa_clean_joint_invariant E rho h hF hFault s hgate).2
    exact pcsa_pending_result_covers_heads E rho h hF x hx (s + 1) B X hc
      (fun z H hH => hAux.heads s (s + 1) (Nat.lt_succ_self _) (le_refl _) y B hB z H hH) hX
end AvailableChain.PCSA.Run
/-! Clean HEAD cone exports. -/
namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] {c : AppCodec In} {m : FGMode}

/-- Every next live root is compatible with a common honest HEAD prefix. -/
theorem pcsa_clean_cone_root_compatible [Fintype V] (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hf : FaultsBelowQA p c rho) (s : Slot) (B : Block)
    (he : SA.earlyTime p.toParams s ≤ cut)
    (hheads : ∀ y G, HonestHeadAt p c E rho y s G → Block.Preceq B G)
    (x : V) (hx : x ∈ rho.honest) (R : Block)
    (hR : liveRootAt p c E rho x (s + 1) = some R) : Block.Compatible R B := by
  obtain ⟨Hon, hHon, hbatch⟩ := pcsa_clean_head_batch_early E rho h s he
  obtain ⟨j, hj⟩ := Finset.card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) hbatch)
  obtain ⟨hjh, hjw⟩ := (hHon j).mp hj
  have hvote : SA.voteTime p.toParams s ≤ rho.horizon := by
    apply le_trans _ (he.trans h.cut.2)
    change 4 * p.Δ * (s : Int) + p.Δ ≤ 4 * p.Δ * (s : Int) + 2 * p.Δ
    have hp := p.deltaPos
    linarith
  obtain ⟨G, hG⟩ := pcsa_honest_head_exists E rho h.base _ hjh s hjw hvote
  rcases pcsa_next_root_source E rho h.base hF hf x hx s R hR with hg | ha | hr
  · subst R
    exact Gen.Pure.block_compatible_of_common (Gen.Pure.block_genesis_preceq B)
      (Gen.Pure.block_preceq_refl B)
  · obtain ⟨y, l, ha, ht⟩ := ha
    have hls := pcsa_early_label_before_vote p l s ht
    rcases lt_or_eq_of_le hls with hlt | rfl
    · exact Gen.Pure.block_compatible_of_common
        (pcsa_clean_ack_to_head_at_early E rho h hF hf l s hlt he y _ R G ha hG)
        (hheads _ G hG)
    · obtain ⟨z, hz⟩ := pcsa_ack_has_honest_head E rho h.base hF hf y _ R ha
      exact Gen.Pure.block_compatible_of_common (Gen.Pure.block_preceq_refl R)
        (hheads z R hz)
  · obtain ⟨l, X, hlt, hX, hRX⟩ := hr
    exact Gen.Pure.block_compatible_of_common
      (Gen.Pure.block_preceq_trans hRX
        (pcsa_clean_head_above_past_at_early E rho h hF hf s he _ G hG x hx l X hlt hX))
      (hheads _ G hG)

/-- The next honest HEAD covers every common predecessor prefix after the early cut. -/
theorem pcsa_clean_heads_cone_past_cut [Fintype V] (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hf : FaultsBelowQA p c rho)
    (hF : StageOneFrame p c E rho) (i : Slot) (B : Block) (hi : 0 < i)
    (he : SA.earlyTime p.toParams (i - 1) ≤ cut)
    (hheads : ∀ y G, HonestHeadAt p c E rho y (i - 1) G → Block.Preceq B G)
    (x : V) (H : Block) (hH : HonestHeadAt p c E rho x i H) : Block.Preceq B H := by
  classical
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi)
  simp only [Nat.succ_sub_one] at he hheads
  by_cases hs : s = 0
  · subst s
    obtain ⟨Hon, hHon, hbatch⟩ := pcsa_clean_head_batch_early E rho h 0 he
    obtain ⟨j, hj⟩ := Finset.card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) hbatch)
    obtain ⟨hjh, hjw⟩ := (hHon j).mp hj
    have hvote : SA.voteTime p.toParams 0 ≤ rho.horizon := by
      apply le_trans _ (he.trans h.cut.2)
      change 4 * p.Δ * (0 : Int) + p.Δ ≤ 4 * p.Δ * (0 : Int) + 2 * p.Δ
      have hp := p.deltaPos
      linarith
    obtain ⟨G, hG⟩ := pcsa_honest_head_exists E rho h.base _ hjh 0 hjw hvote
    have hBG := hheads _ G hG
    rw [pcsa_honestHead_zero E rho _ G hG] at hBG
    have hB : B = .genesis := of_decide_eq_true hBG
    rw [hB]
    exact Gen.Pure.block_genesis_preceq H
  · have hx := hH.1
    have hhead := hH.2.2
    rw [pcsa_voteHeadAt_def] at hhead
    obtain ⟨nd, hnd, hhead⟩ := Option.map_eq_some_iff.mp hhead
    obtain ⟨k, hk, hstore⟩ := pcsa_postClock_source E rho x _ nd hnd
    have hR : liveRootAt p c E rho x (s + 1) =
        some (liveRoot p nd.st (voterPC p nd.st (s + 1))) := by
      rw [pcsa_liveRootAt_def, hnd]
      rfl
    have hcompat := pcsa_clean_cone_root_compatible E rho h hF hf s B he hheads x hx _ hR
    rw [hstore] at hhead hcompat
    let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.voteTime p.toParams (s + 1))
    let raw := headVotes p st (s + 1)
    let sup := headSupport p st (s + 1)
    obtain ⟨Hon, hbatch, hcap, hsup, hbound, hpath⟩ :=
      pcsa_clean_cone_inputs E rho h hF s B he hheads k x hx hk
    have hsub : sup ⊆ raw :=
      pcsa_headSupport_subset_at_read E rho h.base.valid.toDeliveryWellFormed k x _ (s + 1)
    have hcounts := Gen.AC.Root.transfer_n2 st.base.blocks raw sup Hon Hon.card
      (Gen.V2.Duty.faulty rho).card B hsub rfl hcap hsup hbound hbatch
    have hcover := pcsa_headInTree_covers_of_transfer p st (voterPC p st (s + 1))
      (erasedList st (KitFG.storeFrameView (FGSA.heightView p) st.fg (voterBlocks p st (s + 1))))
      raw sup B hcompat (fun C _ hCB => hpath C hCB) hcounts.2.2.2.2.2.1 hcounts.2.2.2.2.2.2
    delta headVote at hhead
    rw [ite_eq_right (Nat.succ_ne_zero s)] at hhead
    rw [← hhead]
    exact hcover

/-- The full HEAD cone also holds when the next vote is inside the clean cut. -/
theorem pcsa_clean_heads_cone_at_vote [Fintype V] (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hf : FaultsBelowQA p c rho)
    (hF : StageOneFrame p c E rho) (i : Slot) (B : Block) (hi : 0 < i)
    (hv : SA.voteTime p.toParams i ≤ cut)
    (hheads : ∀ y G, HonestHeadAt p c E rho y (i - 1) G → Block.Preceq B G)
    (x : V) (H : Block) (hH : HonestHeadAt p c E rho x i H) : Block.Preceq B H := by
  apply pcsa_clean_heads_cone_past_cut E rho h hf hF i B hi _ hheads x H hH
  apply le_trans _ hv
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi)
  simp only [Nat.succ_sub_one]
  change 4 * p.Δ * (s : Int) + 2 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
  push_cast
  have hp := p.deltaPos
  linarith

end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
/-- [pcsa34-r4.3 §5.3, F4] Every honest result of a label before an honest proposal is below
the proposal parent. The proposer head at `t_u` extends the results of label `u − 1`
(`pcsa_clean_proposer_head_above_result`); the C6 results chain carries the lower labels. -/
theorem pcsa_clean_result_below_proposal_parent (p : Params) :
    ∀ {V : Type} [DecidableEq V] [Fintype V] {In : Type} (c : AppCodec In)
      (m : FGMode) (E : Generic.Env V) (rho : V2.D.Run V (pcsaWith m p c))
      (b₀ ΔF : Time),
      Clean₂ p c E rho b₀ ΔF → FaultsBelowQA p c rho → StageOneFrame p c E rho →
      ∀ (u : Slot) (N : NamedProposal p.n), 0 < u → HonestNamedProposal p c E rho u N →
        SA.gateTime p.toParams (u - 1) ≤ b₀ →
        ∀ x ∈ rho.honest, ∀ (i : Slot) (X : Block), i ≤ u - 1 →
          gateResultAt p c E rho x i = some (some X) → Block.Preceq X N.erase.parent := by
  intro V _ _ In c m E rho b₀ ΔF hC hf hF u N hu hN hc x hx i X hi hX
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hu)
  simp only [Nat.succ_sub_one] at hc hi
  have hCI := (pcsa_clean_joint_invariant E rho hC hF hf s hc).1
  obtain ⟨hw, he⟩ := hN
  obtain ⟨k, hk, _, hslot, _, _, _, hparent⟩ := pcsa_emitted_proposal_inputs E rho _ (s + 1) N he
  obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho hC hF x hx s hc
  have hXD : Block.Preceq X D := by
    rcases hi.lt_or_eq with hlt | heq
    · exact (hCI.resultsChain x hx x hx i s X D hi (le_refl _) hX hD).1 hlt
    · subst i
      rw [Option.some.inj (Option.some.inj (hX.symm.trans hD))]
      exact Gen.Pure.block_preceq_refl _
  have hDH := pcsa_clean_proposer_head_above_result E rho hC hF s hCI hc k _ x hw hx hk D hD
  have hpar : N.erase.parent = N.parent.erase := by
    have h1 := pcsa_named_parent_of_positive N (hslot ▸ Nat.succ_pos s)
    generalize N.erase = B at h1 ⊢
    cases B with
    | genesis => cases h1
    | node Q r root app => exact Option.some.inj h1
  rw [hpar, hparent]
  exact Gen.Pure.block_preceq_trans hXD hDH
/-- [pcsa34-r4.3 §5.3, F3] Every honest voter awake at `v_u` reads the target of the carried
PC of an honest proposal at label `u` (`pcsa_common_view_targets` at the post-clock vote read). -/
theorem pcsa_clean_formation_commonView (p : Params) :
    ∀ {V : Type} [DecidableEq V] [Fintype V] {In : Type} (c : AppCodec In)
      (m : FGMode) (E : Generic.Env V) (rho : V2.D.Run V (pcsaWith m p c))
      (b₀ ΔF : Time),
      Clean₂ p c E rho b₀ ΔF → FaultsBelowQA p c rho → StageOneFrame p c E rho →
      ∀ (u : Slot) (N : NamedProposal p.n), 0 < u → HonestNamedProposal p c E rho u N →
        SA.gateTime p.toParams (u - 1) ≤ b₀ →
        ∀ y ∈ rho.honest, E.awake y (SA.voteTime p.toParams u) = true →
          (viewAt p c E rho y u).map (Option.map PC.target) = some (N.pc.map PC.target) := by
  intro V _ _ In c m E rho b₀ ΔF hC hf hF u N hu hN hc y hy _
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hu)
  simp only [Nat.succ_sub_one] at hc
  obtain ⟨hw, he⟩ := hN
  obtain ⟨k, hk, _, hslot, _, _, hpc, _⟩ := pcsa_emitted_proposal_inputs E rho _ (s + 1) N he
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have hvc : SA.voteTime p.toParams (s + 1) ≤ b₀ := by
    apply le_trans _ hc
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    push_cast
    linarith
  have hmem := (pcsa_honest_proposal_before_vote E rho hC.base hF hC.healthy _ y hw hy (s + 1) N
    he hvc _ (le_refl _)).1
  have hview := pcsa_common_view_targets E rho hC.base hF hf hC.healthy k y hy s N hw he hk hslot
    hvc hmem hpc
  have hpub : V2.PublicTime E (SA.voteTime p.toParams (s + 1)) := by
    refine ⟨4 * (s + 1) + 1, ?_⟩
    rw [hC.base.delta]
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ = ((4 * (s + 1) + 1 : Nat) : Int) * p.Δ
    push_cast
    ring
  have h0 : 0 ≤ SA.voteTime p.toParams (s + 1) := by
    change 0 ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    positivity
  obtain ⟨nd, hnd⟩ := pcsa_postClock_exists E rho hC.base y hy _ hpub h0 (hvc.trans hC.cut.2)
  obtain ⟨k', hk', hst⟩ := pcsa_postClock_source E rho y _ nd hnd
  have hpre := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime
    hC.base.valid.toScheduleWellFormed hC.base.noRestart hk'
  rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ hC.base.valid.toScheduleWellFormed] at hpre
  rw [pcsa_viewAt_def, hnd, Option.map_some, Option.map_some, hst, hpre, hview, hpc]
  rfl
/-- [pcsa34-r4.3 §5.3, F4] A live lock at the post-clock vote read of `v_u` is a lock row of
the inclusive store at `v_u − 1` (`pcsa_vote_locks_subset`, `pcsa_pre_tick_storeAt`). -/
theorem pcsa_clean_formation_leaseRead (p : Params) :
    ∀ {V : Type} [DecidableEq V] [Fintype V] {In : Type} (c : AppCodec In)
      (m : FGMode) (E : Generic.Env V) (rho : V2.D.Run V (pcsaWith m p c))
      (b₀ ΔF : Time),
      Clean₂ p c E rho b₀ ΔF → FaultsBelowQA p c rho → StageOneFrame p c E rho →
      ∀ (u : Slot) (N : NamedProposal p.n), 0 < u → HonestNamedProposal p c E rho u N →
        SA.gateTime p.toParams (u - 1) ≤ b₀ →
        ∀ y ∈ rho.honest, E.awake y (SA.voteTime p.toParams u) = true →
          ∀ nd, pcsa_postClock E rho y (SA.voteTime p.toParams u) = some nd →
          ∀ B, LiveLease nd.st B →
            Block.Compatible B ((N.pc.map PC.target).getD (eraseFG (controls p nd.st).Z)) →
            ((N.pc.map PC.target).getD (eraseFG (controls p nd.st).Z)).depth < B.depth →
            ∃ t : Time, ∃ row, t < SA.voteTime p.toParams u ∧
              row ∈ (storeAt p c E rho y t).base.obligations ∧ row.1 = B := by
  intro V _ _ In c m E rho b₀ ΔF hC _ _ u N _ _ _ y _ _ nd hnd B hLive _ _
  obtain ⟨k, hk, hst⟩ := pcsa_postClock_source E rho y _ nd hnd
  obtain ⟨row, hrow, hrB, _⟩ := hLive
  rw [hst] at hrow
  have hrow' := pcsa_vote_locks_subset p _ u hrow
  rw [pcsa_pre_tick_storeAt E rho hC.base k y _ hk] at hrow'
  exact ⟨SA.voteTime p.toParams u - 1, row, sub_one_lt _, hrow', hrB⟩
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
/-- [pcsa34-r4.3 §5.3 part 4] Clean stamping: an honest proposal at `u` with `h_u ≥ q_N` is a
PC stamped before `z_u` at every honest node, when `z_u ≤ b₀`. Predecessor C6 fixes every honest
HEAD at `u` (`pcsa_clean_emitted_heads_equal`); the HEADs pass the early N count, the early view
is below the proposal, the acks form a PC quorum, and the freeze collects it. -/
theorem pcsa_clean_honestProposal_stamped (p : Params) :
    ∀ {V : Type} [DecidableEq V] [Fintype V] {In : Type} (c : AppCodec In)
      (m : FGMode) (E : Generic.Env V) (rho : V2.D.Run V (pcsaWith m p c))
      (b₀ ΔF : Time),
      Clean₂ p c E rho b₀ ΔF → QuarterCap p c rho → StageOneFrame p c E rho →
      ∀ (u : Slot) (N : NamedProposal p.n), 0 < u → HonestNamedProposal p c E rho u N →
        nQuorum p.n ≤ (awakeHonestLabel p c E rho u).card →
        SA.freezeTime p.toParams u ≤ b₀ →
        ∀ y ∈ rho.honest,
          PCStampedBefore p c E rho y (SA.freezeTime p.toParams u) u N.erase := by
  intro V _ _ In c m E rho b₀ ΔF hC hQc hF u N hu hN hQ hz
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hu)
  have hFault := pcsa_c9_faultsBelowQA_of_quarterCap rho hQc
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have hds : SA.gateTime p.toParams s ≤ b₀ := by
    apply le_trans _ hz
    change 4 * p.Δ * (s : Int) + 6 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 3 * p.Δ
    push_cast
    linarith
  have hez : SA.earlyTime p.toParams (s + 1) ≤ SA.freezeTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + 2 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 3 * p.Δ
    linarith
  have hve : SA.voteTime p.toParams (s + 1) ≤ SA.earlyTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 2 * p.Δ
    linarith
  have hec := hez.trans hz
  have hvc := hve.trans hec
  have hCI := (pcsa_clean_joint_invariant E rho hC hF hFault s hds).1
  obtain ⟨hw, he⟩ := hN
  have hHeads : ∀ x H, HonestHeadAt p c E rho x (s + 1) H → H = N.erase :=
    fun x H hH => pcsa_clean_emitted_heads_equal E rho hC hF hFault s hCI hds N hw he x H hH
  have hslot : N.erase.slot = s + 1 := pcsa_proposal_emitted_slot E rho _ (s + 1) N _ he
  have hNc := pcsa_c9_early_N E rho hC.base hF hC.healthy (s + 1) N.erase hec
    (hec.trans hC.cut.2) hQ hHeads
  have hAck : ∀ y ∈ rho.honest, E.awake y (SA.earlyTime p.toParams (s + 1)) = true →
      HonestAckAt p c E rho y (s + 1) N.erase := by
    intro y hy haw
    obtain ⟨nd, hnd, hn⟩ := hNc y hy
    exact pcsa_c9_honestAck E rho (s + 1) N.erase y nd hy haw hnd hslot hn
      (pcsa_c9_early_view_below E rho hC.base hF hFault hC.healthy s N hw he hvc y hy nd hnd)
  have hBody : ∀ y ∈ rho.honest, N.erase ∈ (V2.D.Run.stateBefore E rho
      (V2.D.Run.idxBefore rho (SA.freezeTime p.toParams (s + 1))) y).st.base.blocks :=
    fun y hy => (pcsa_honest_proposal_before_vote E rho hC.base hF hC.healthy _ y hw hy (s + 1)
      N he hvc _ (pcsa_c9_idxBefore_mono rho (hve.trans hez))).2
  exact pcsa_c9_stamped E rho hC.base hF hC.healthy (s + 1) N.erase (Nat.succ_pos s) hslot hz
    (hz.trans hC.cut.2) hBody (pcsa_c9_ack_quorum E rho hC.base (s + 1) N.erase hQ hAck)
end AvailableChain.PCSA.Run

end

public section
namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}

/-- Formation supplies its full conclusion from the run premise. -/
theorem pcsa_formation_concl_of_premise (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (s : Slot) (N : NamedProposal p.n) (ΔF : Time)
    (h : FormationPrem p c E rho s N ΔF) : FormationConcl p c E rho s N := by
  have hpf := h.toPreFreeze p c E rho
  have hInputs := pcsa_formation_preFreeze_inputs_of_premise E rho s N ΔF hpf
  obtain ⟨hh, hn, ha, hp⟩ := pcsa_formation_preFreeze E rho s N ΔF hpf hInputs
  rw [FormationConcl_def]
  exact ⟨hh, hn, ha, hp, pcsa_formation_gate_of_counts E rho s N ΔF h
    (pcsa_formation_gate_counts E rho s N ΔF h hh)⟩

end AvailableChain.PCSA.Run

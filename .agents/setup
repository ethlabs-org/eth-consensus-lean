#!/usr/bin/env bash
# Development environment setup: the toolchain and dependencies of CI (.github/workflows/ci.yml), installed
# once per environment snapshot. Idempotent; a warm rerun only confirms what the snapshot already holds.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() { printf '\n==> %s\n' "$*"; }
timed() { local t=$SECONDS; "$@"; printf '    (%ss)\n' "$((SECONDS - t))"; }

# bubblewrap for `lake check` / `lake comparator`; jq for configuration checks; gh/zstd for build restore.
install_packages() {
  local missing=()
  command -v bwrap >/dev/null || missing+=(bubblewrap)
  command -v jq >/dev/null || missing+=(jq)
  command -v gh >/dev/null || missing+=(gh)
  command -v zstd >/dev/null || missing+=(zstd)
  if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
  fi
  bwrap --ro-bind / / --unshare-user true
}

# elan v4.2.4, pinned and sha256-checked as in CI. The proxies are linked into /usr/local/bin so
# every shell (login or not, services included) finds lean/lake without a profile hook.
install_elan() {
  local elan_bin="$HOME/.elan/bin"
  if [[ ! -x "$elan_bin/elan" ]]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -sSfL https://github.com/leanprover/elan/releases/download/v4.2.4/elan-x86_64-unknown-linux-gnu.tar.gz -o "$tmp/elan.tgz"
    echo "42b94d4244e8353142c456ec0e4ca6528fd898a6c604d4059f494e706e431f63  $tmp/elan.tgz" | sha256sum --strict -c -
    tar -xzf "$tmp/elan.tgz" -C "$tmp"
    "$tmp/elan-init" -y --no-modify-path --default-toolchain none
    rm -rf "$tmp"
  fi
  local f
  for f in "$elan_bin"/*; do
    [[ "$(readlink "/usr/local/bin/${f##*/}" 2>/dev/null)" == "$f" ]] || sudo ln -sfn "$f" "/usr/local/bin/${f##*/}"
  done
}

# elan installs the lean-toolchain pin on first use; a warm run just reports it.
install_toolchain() {
  lean --version
  lake --version
}

# lakeprof (Kha/lakeprof, Apache-2.0), pinned: build-level profiles (per-module times, critical path,
# simulated parallelism, Chrome trace). Linked into /usr/local/bin like the elan proxies. Optional: a
# failure only warns (see `optional` below).
install_lakeprof() {
  local rev=4b456daea316fae73974c468e52b9b1807f6007d bin
  uv tool install --quiet --from "git+https://github.com/Kha/lakeprof@$rev" lakeprof || return 1
  bin="$(uv tool dir --bin)/lakeprof"
  [[ -x "$bin" ]] || return 1
  sudo ln -sfn "$bin" /usr/local/bin/lakeprof
  lakeprof --help >/dev/null
}

# Run an optional step: its failure warns and setup goes on (a failed setup blocks the snapshot).
optional() { "$@" || echo "WARNING: optional step $1 failed; setup continues without it" >&2; }

step "System packages (bubblewrap, jq, gh, zstd)"; timed install_packages
# The pre-push hook: a push to main must have passed scripts/push-main.sh (AGENTS.md "Land on main").
step "git hooks (scripts/hooks)"; git config core.hooksPath scripts/hooks
step "elan v4.2.4"; timed install_elan
step "Lean toolchain $(cat lean-toolchain)"; timed install_toolchain
# Clones the pinned packages of lake-manifest.json and downloads Mathlib's prebuilt oleans.
step "Lake packages and Mathlib cache"; timed lake exe cache get
# The project build of the newest green main run at or below HEAD (CI's `lake-build` artifact), so a snapshot
# older than main rebuilds only the modules changed since, not the whole library. Optional: without gh access
# or a matching artifact the prebuild below builds from scratch.
step "Project build from CI (optional)"; timed optional scripts/restore-build.sh
# Prebuild the default targets so the snapshot holds them (about 7 min cold on 4 cores, seconds when restored). A broken
# commit must not fail setup: that would block the snapshot that holds everything above.
step "lake build (default targets)"
t=$SECONDS
lake build || echo "WARNING: lake build failed; the toolchain and Mathlib cache are still installed" >&2
printf '    (%ss)\n' "$((SECONDS - t))"
step "lakeprof (optional)"; timed optional install_lakeprof
